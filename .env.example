# --- Maʼlumotlar bazasi ---
# Production uchun PostgreSQL ulanish satri (Supabase, Neon yoki o'zingizning serveringiz).
# Bo'sh qoldirilsa, lokal ishlab chiqishda o'rnatilgan PGlite (.data/pglite) ishlatiladi.
# POSTGRES_URL nomi ham qabul qilinadi. Birinchi ishga tushishda migratsiya va (baza boʻsh boʻlsa) kontent avtomatik yoziladi.
DATABASE_URL=

# --- Sayt ---
# Kanonik URL (sitemap, Open Graph va CSRF tekshiruvi uchun)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tekshirilmagan (ulamolar tasdiqlamagan) diniy kontentni ko'rsatish siyosati:
#   reviewed_only   - faqat tasdiqlangan kontent ommaga ko'rinadi (ishga tushirish uchun tavsiya etiladi)
#   include_pending - tekshiruvdagi kontent ham ko'rinadi, lekin aniq ogohlantirish belgisi bilan
CONTENT_VISIBILITY=include_pending

# Sessiya cookie'si uchun maxfiy kalit emas — sessiyalar tasodifiy token + SHA-256 xesh bilan saqlanadi.

# Birinchi administrator(lar): shu manzil bilan roʻyxatdan oʻtgan yoki kirgan foydalanuvchi admin boʻladi.
# Vergul bilan bir nechta manzil. Administrator tayinlangach, oʻzgaruvchini olib tashlash tavsiya etiladi.
BOOTSTRAP_ADMIN_EMAILS=
